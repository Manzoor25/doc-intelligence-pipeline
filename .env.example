# ============================================================================
# Model Endpoint Configuration (OpenAI-Compatible Chat Completions API)
# All model access reads ONLY these three core variables. No vendor is hard-coded.
# Defaults below point to the built-in local mock endpoint in Docker Compose
# so `make up` works out of the box with zero API keys.
# See README.md for verified Groq, Vertex AI, Azure Foundry, and Ollama configs.
# ============================================================================
LLM_BASE_URL=http://mock-llm:8001/v1
LLM_API_KEY=mock-key-not-secret
LLM_MODEL=mock-vision-strict-v1

# Optional pricing overrides (USD per 1M tokens) for cost accounting
LLM_COST_INPUT_PER_1M=0.15
LLM_COST_OUTPUT_PER_1M=0.60
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REPAIR_ATTEMPTS=2

# Extraction & Routing Policy
# EXTRACTION_MODE: auto (chosen by startup probe) | vision | ocr_text
EXTRACTION_MODE=auto
VISION_MAX_IMAGE_EDGE=1600
ENABLE_TWO_PASS=true
REVIEW_CONFIDENCE_THRESHOLD=0.85

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://ap_user:ap_dev_password_change_me@postgres:5432/doc_intelligence

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_only
MINIO_BUCKET=ap-documents
MINIO_SECURE=false

# Watched Folder & Exports
WATCH_DIR=/app/data/inbox
EXPORT_CSV_PATH=/app/data/exports/approved_payables.csv
FINANCE_WEBHOOK_URL=http://api:8000/mock-erp/webhooks/payables
FINANCE_WEBHOOK_SECRET=dev-webhook-hmac-secret-change-me
